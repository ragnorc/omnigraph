query ic11($personId: I64, $countryName: String, $workFromYear: I32) {
    match {
        $p: Person { id: $personId }
        $p <knows>{1,2} $f
        $f.id != $personId
        $f $w:workAt $o
        $o orgIsLocatedIn $c
        $c.name = $countryName
        $w.workFrom < $workFromYear
    }
    return { $f.id, $f.firstName, $f.lastName, $o.name, $w.workFrom }
    order { $w.workFrom, $f.id, $o.name desc }
    limit 10
}
