query ic1($personId: I64, $firstName: String) {
    match {
        $p: Person,
        $p <knows>{1,3} $f,
        $f personIsLocatedIn $city,
    }
    where $p.id = $personId and $f.firstName = $firstName and $f.id != $personId
    return { $f.id, $f.lastName, $f.birthday, $f.creationDate, $f.gender, $f.browserUsed, $f.locationIP, $city.name }
    order { $f.lastName, $f.id }
    limit 20
}
