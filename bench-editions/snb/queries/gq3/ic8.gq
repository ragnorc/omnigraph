query ic8($personId: I64) {
    match {
        $p: Person,
        $m hasCreator $p,
        $c replyOf $m,
        $c hasCreator $a,
    }
    where $p.id = $personId
    return { $a.id, $a.firstName, $a.lastName, $c.creationDate, $c.id, $c.content }
    order { $c.creationDate desc, $c.id }
    limit 20
}
