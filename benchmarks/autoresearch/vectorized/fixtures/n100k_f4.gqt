# issue: none
# notes: autoresearch vectorized-execution fixture: 100000 people, 400000 edges (fanout 4, uniform), bio x1, 25 node commits.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I64
    team: String
    bio: String
    score: I64
}
edge Knows: Person -> Person {
    weight: I64
}

--- seed generate: v1 seed: 42
tables:
  - kind: node
    name: Person
    rows: 100000
    commits: 25
    columns:
      name: {kind: key, prefix: p, width: 6}
      age: {kind: modulo, modulus: 100}
      team: {kind: key, prefix: g, width: 0, modulo: 10}
      bio: {kind: repeat, text: "synthetic person biography ", count: 1}
      score: {kind: ordinal, start: 0, step: 7}
  - kind: edge
    name: Knows
    rows: 400000
    commits: 98
    id: {kind: key, prefix: e, width: 8}
    from: {kind: endpoint, prefix: p, width: 6, population: 100000, distribution: {kind: uniform}}
    to: {kind: endpoint, prefix: p, width: 6, population: 100000, distribution: {kind: uniform}}
    columns:
      weight: {kind: modulo, modulus: 1000}
