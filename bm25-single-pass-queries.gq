query bm25_body($q: String) {
  match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.body, $q) as $score }
  return { $d.slug, $score as score }
  order { $score desc }
  limit 10
}

query bm25_body_filtered($q: String) {
  match { let $pop = { match { $d: Doc } where $d.year > 2005 return { $d } }, from bm25($pop, $d.body, $q) as $score }
  return { $d.slug, $score as score }
  order { $score desc }
  limit 10
}

query bm25_title($q: String) {
  match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.title, $q) as $score }
  return { $d.slug, $score as score }
  order { $score desc }
  limit 10
}

query bm25_title_filtered($q: String) {
  match { let $pop = { match { $d: Doc } where $d.year > 2005 return { $d } }, from bm25($pop, $d.title, $q) as $score }
  return { $d.slug, $score as score }
  order { $score desc }
  limit 10
}

query match_terms_body($q: String) {
  match { $d: Doc }
  where match_terms($d.body, terms($q, mode: any))
  return { $d.slug }
  order { $d.slug }
}

query rrf_bm25($v: Vector(8), $q: String) {
  match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.emb, $v, k: 10), bm25($all, $d.title, $q), k: 60) as $score }
  return { $d.slug, $score as s }
  order { $score desc }
  limit 10
}
