id: e3-29
task: m3
class: a drawn column that is neither a variable nor aliased
code: T74

--- text
query big_employers($min: I64) {
  match {
    from { match { $c: Company, $p: Person, $p worksAt $c } return { $c, count($p) } },
  }
  where $n >= $min
  return { $c.name, $n }
  order { $n desc }
}
