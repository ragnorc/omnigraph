  where $d.tags contains "rust"
  return { $d.title }
}

--- seed
id: e3-03
task: t28
class: a positional option (edition 2's `fuzzy` budget)
code: T6

--- text
query mentions($s: String, $q: String) {
  match { $d: Doc }
  where match_terms($d.body, terms($s, mode: any)) and fuzzy($d.body, $q, 2)
  return { $d.title }
}

--- seed
id: e3-04
task: t24
class: a ranking in `order` (edition 2's spelling)
code: T65

--- text
query similar($q: Vector(3)) {
  match { $d: Doc }
  where $d.year >= 2025
  return { $d.title }
  order { nearest($d.embedding, $q) }
  limit 20
}

--- seed
id: e3-05
task: t27
class: a ranking in `return` and `order` (edition 2's spelling)
code: T65

--- text
query about($q: String) {
  match { $d: Doc }
  return { $d.title, bm25($d.body, $q) as s }
  order { bm25($d.body, $q) desc }
  limit 10
}

