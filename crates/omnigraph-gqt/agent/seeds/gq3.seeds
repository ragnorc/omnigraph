code: Q007

--- text
query around($h: String) {
  match { $p: Person, $p -knows- $f }
  where $p.handle = $h
  return { $f.name }
}

--- seed
id: e3-19
task: t22
class: `let … in` (a row-binding `let`)
code: Q012

--- text
query latest_per_author() {
  match {
    $p: Person,
    let $d in { match { $d: Doc, $p authored $d } return { $d } order { $d.year desc } limit 3 },
  }
  return { $p.name, $d.title, $d.year }
}

