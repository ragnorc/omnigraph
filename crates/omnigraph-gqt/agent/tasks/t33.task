--- task
id: t33
dataset: section8
kind: delete by predicate

--- intent
Remove every employment link of the person with handle `$h`.

--- params
{"h": "alice"}

--- edition2
query retire($h: String) {
  delete WorksAt where @src = $h
}

--- edition3
query retire($h: String) {
  match { $p: Person, $p $k:worksAt $c }
  where $p.handle = $h
  delete $k
}

--- edition3
query retire($h: String) {
  match { $x: WorksAt }
  where $x.@src = $h
  delete $x
}

--- check
query check() {
  match { $p: Person, $p worksAt $c }
  return { $p.handle, $c.slug }
}

--- expect unordered
columns: ["p.handle","c.slug"]
["bob","acme"]
["dave","acme"]
["erin","globex"]
