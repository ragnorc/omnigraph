# issue: 1278
# red_on: main 4ebbf719, where a keyed insert built the whole row with a null for every omitted property and the merge-insert replaced the matched row, so d1 lost n and emb, d3 lost n and the edge lost its note.
# notes: A keyed insert that names only some properties of an existing entity updates the
# notes: properties it names and keeps the others, on a node and on a keyed edge, for a
# notes: committed row and for a row inserted earlier in the same mutation. A new key still
# notes: gets null for every omitted nullable property.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    title: String
    n: I64?
    emb: Vector(2)?
}

edge Cites: Doc -> Doc {
    weight: I64?
    note: String?
    @key(@src, @dst)
}

--- seed
{"type":"Doc","data":{"slug":"d1","title":"old","n":7,"emb":[1.0,2.0]}}
{"type":"Doc","data":{"slug":"d2","title":"two","n":8}}
{"edge":"Cites","from":"d1","to":"d2","data":{"weight":3,"note":"seed"}}

--- mutate
query retitle() {
    insert Doc { slug: "d1", title: "new" }
}

--- expect affected: nodes=1 edges=0

--- mutate
query reweigh() {
    insert Cites { from: "d1", to: "d2", weight: 4 }
}

--- expect affected: nodes=0 edges=1

--- mutate
query insert_then_retitle() {
    insert Doc { slug: "d3", title: "first", n: 9 }
    insert Doc { slug: "d3", title: "second" }
}

--- expect affected: nodes=2 edges=0

--- mutate
query new_key() {
    insert Doc { slug: "d4", title: "fresh" }
}

--- expect affected: nodes=1 edges=0

--- query
query docs() {
    match { $d: Doc }
    return { $d.slug, $d.title, $d.n, $d.emb }
}

--- expect unordered
{"d.slug": "d1", "d.title": "new", "d.n": 7, "d.emb": [1.0, 2.0]}
{"d.slug": "d2", "d.title": "two", "d.n": 8}
{"d.slug": "d3", "d.title": "second", "d.n": 9}
{"d.slug": "d4", "d.title": "fresh"}

--- expect shape
d.slug: String
d.title: String
d.n: I64?
d.emb: Vector(2)?

--- query
query cites() {
    match { $a: Doc $a $c:cites $b }
    return { $a.slug, $b.slug, $c.weight, $c.note }
}

--- expect unordered
{"a.slug": "d1", "b.slug": "d2", "c.weight": 4, "c.note": "seed"}

--- expect shape
a.slug: String
b.slug: String
c.weight: I64?
c.note: String?
