# issue: none
# notes: a merge whose source inserted 128 Person rows, one commit each, while main moved Knows.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

edge Knows: Person -> Person

--- seed
{"type":"Person","data":{"name":"a","age":0}}
{"type":"Person","data":{"name":"b","age":0}}

--- mutate
branch create feature;

--- expect ok

