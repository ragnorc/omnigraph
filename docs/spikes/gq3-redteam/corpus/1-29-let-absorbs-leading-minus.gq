// task: a let followed by a filter that begins with a negative literal
// kind: lookups-and-filters
// expect: accept
// rfc: §3 arithmetic; parser spike F5
// shape: $p: Person | let $x = $p.age - 1 < $x
// note: F5 refuses a filter that begins with `-`, but after a let the ladder takes the `-` first, so the let's value silently becomes a comparison
query q() {
  match { $p: Person  let $x = $p.age  -1 < $x }
  return { $p.name }
}
