// task: cited_near rewritten with the population named by let first
// kind: ranking-and-search
// expect: accept
// rfc: §8 rewritten (A6's literal-and-reference exception)
query cited_near($coll: String, $q: Vector(3)) {
  match {
    let $pop = { match { $x: Collection { slug: $coll }  $d "in" $x } return { $d } }
    from nearest($pop, embedding, $q, k: 20)
    $d cites $other
  }
  return { $d.title, $distance, count($other) as cites }
  order { $distance }
}
