// task: every recent document within a distance, by l2
// kind: ranking-and-search
// expect: accept
// rfc: asset §5
query q($q: Vector(3), $r: F32) {
  match { from l2({ match { $d: Doc  $d.year >= 2025 } return { $d } }, embedding, $q)  $distance <= $r }
  return { $d.title, $distance }
  order { $distance, $d.id }
  limit 10
}
