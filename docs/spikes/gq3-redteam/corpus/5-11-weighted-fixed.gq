// task: the weighted hybrid with match added to the inner reads
// kind: ranking-and-search
// expect: accept
// rfc: asset §5 rewritten
query weighted($q: String, $v: Vector(3)) {
  match {
    let $docs = { match { $d: Doc } return { $d } }
    from { match { from l2($docs, embedding, $v) } return { $d, $distance as vec } }
    from { match { from bm25($docs, body, $q) } return { $d as d2, $score as lex } }
    $d = $d2
  }
  return { $d.title, 0.7 * (1.0 / (1.0 + $vec)) + 0.3 * $lex as s }
  order { $s desc }
  limit 10
}
