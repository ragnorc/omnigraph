// task: three fused arms with weights
// kind: ranking-and-search
// expect: accept
// rfc: §4 Fusion
query q($q: String, $v: Vector(3)) {
  match {
    let $docs = { match { $d: Doc } return { $d } }
    from rrf(nearest($docs, embedding, $v, k: 50), bm25($docs, body, $q), bm25($docs, title, $q), k: 60, weights: [0.5, 0.3, 0.2])
  }
  return { $d.title, $score }
  order { $score desc }
}
