// task: nearest over a node binding instead of a relation (the unresolved shorthand)
// kind: ranking-and-search
// expect: accept
// rfc: unresolved question 1
// later: T69
query q($q: Vector(3)) {
  match { $d: Doc  $d.year > 2020  from nearest($d, embedding, $q, k: 5) }
  return { $d.title }
}
