// task: nearest with the field written as a property access, edition 2's habit
// kind: ranking-and-search
// expect: accept
// rfc: §3: field is an identifier, never a string
// later: type error naming the field form
query q($q: Vector(3)) {
  match { from nearest({ match { $d: Doc } return { $d } }, $d.embedding, $q, k: 5) }
  return { $d.title }
}
