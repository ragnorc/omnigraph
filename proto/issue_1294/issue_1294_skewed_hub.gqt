# issue: 1294
# red_on: probe
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I64?
}
edge Knows: Person -> Person

--- seed generate: v1 seed: 7
tables:
  - kind: node
    name: Person
    rows: 12000
    commits: 3
    columns:
      name: {kind: key, prefix: p, width: 5}
      age: {kind: modulo, modulus: 90}
  - kind: node
    name: Person
    rows: 2
    commits: 1
    columns:
      name: {kind: key, prefix: h, width: 1}
  - kind: edge
    name: Knows
    rows: 256
    commits: 1
    from: {kind: literal, value: h0}
    to: {kind: key, prefix: p, width: 5}
    columns: {}
  - kind: edge
    name: Knows
    rows: 3072
    commits: 1
    from: {kind: literal, value: h1}
    to: {kind: key, prefix: p, width: 5}
    columns: {}

--- query
query friends_h0() { match { $p: Person { name: "h0" } $p knows $f } return { sum($f.age) as total, count($f) as n } }
--- expect unordered
{"n": 256, "total": 10860}
--- expect shape
total: F64?
n: I64

--- query
query friends_h1() { match { $p: Person { name: "h1" } $p knows $f } return { sum($f.age) as total, count($f) as n } }
--- expect unordered
{"n": 3072, "total": 136236}
--- expect shape
total: F64?
n: I64
--- expect plan
scan Person as $f: access id_lookup

--- query
query friends_h0_again() { match { $p: Person { name: "h0" } $p knows $f } return { sum($f.age) as total, count($f) as n } }
--- expect unordered
{"n": 256, "total": 10860}
--- expect shape
total: F64?
n: I64

--- query
query whole_table() { match { $f: Person } return { sum($f.age) as total, count($f) as n } }
--- expect unordered
{"n": 12002, "total": 533100}
--- expect shape
total: F64?
n: I64

