--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  slug: [Bool]
}
node Person {
  body: enum(low, mid, high) @index
  born: [I64]
}

--- seed

--- mutate
query from($arg1: Blob, $arg2: [I64]) {
  update Doc set { slug: [true, true] } where slug contains false
  insert Person { body: "low", born: $arg2 }
}

