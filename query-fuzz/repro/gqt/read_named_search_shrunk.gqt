    storage: local-filesystem

--- schema
node Org {
  vec: String @index
}

--- seed

--- query
query search() {
  match {
    $o1: Org
    search($o1.vec, "cafe")
  }
  return { $o1.@id }
}

--- params
{"arg1": "Dogs"}

--- expect unordered


