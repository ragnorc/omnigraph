# issue: none
# notes: query-fuzz gen v1, world seed 1208, case 2; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  level: F32 @index
  weight: [String]?
  count: F32? @index
  seen: Blob?
  size: Date?
  text: String? @index
  emb: Vector(3)?
  @index(weight)
}

--- seed
{"type":"Person","id":"p0","data":{"level":3.0,"weight":["x y z","naïve","naïve"],"count":0.0,"seen":null,"size":"2020-01-01","text":"","emb":null}}
{"type":"Person","id":"p1","data":{"level":-2.25,"weight":[],"count":0.5,"size":null,"text":"running data and the","emb":[1.67,0.65,-1.15]}}
{"type":"Person","id":"p2","data":{"level":2.5,"weight":["and the"],"count":0.0,"seen":"base64:SGVsbG8=","text":null,"emb":[0.0,0.0,0.0]}}
{"type":"Person","id":"p3","data":{"level":7.0,"weight":["RUN"],"count":0.5,"seen":null,"size":"1970-01-01","text":"base RUN Dogs dog","emb":[0.55,1.76,-0.09]}}
{"type":"Person","id":"p4","data":{"level":2.5,"weight":null,"count":1.5,"size":null,"text":"Run","emb":null}}

--- query
query q3($arg1: Vector(3)) {
  match {
    $p1: Person
    $p1.weight contains "naïve"
    exists { $p1.level >= 2.5 }
  }
  return { $p1.level as c0, $p1 as c1, avg($p1.level) as a0, count(distinct $p1.size) as a1 }
  order { nearest($p1.emb, $arg1) }
  limit 1
}

