# issue: none
# notes: query-fuzz gen v1, world seed 1395, case 2; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  size: Vector(3)
  code: enum(a, b)
  nums: String @key
  vec: enum(red, green, blue, x-1)? @unique
}
node Tag {
  age: DateTime?
  vec: I32
  body: enum(low, mid, high)?
  weight: I64 @key
  @range(weight, -10..1000)
}
node Doc {
  slug: Blob?
  nums: I64?
  text: String? @index
  emb: Vector(3)
}
node Item {
  weight: String @index
  code: Bool? @index
  level: U64
}
edge Likes: Tag -> Person

