# issue: none
# notes: query-fuzz gen v1, world seed 1442, case 14; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  born: String @key
  content: DateTime? @index
}
node Org {
  tags: [I32]?
  born: [Date]?
  flag: I64 @key
}
node Tag {
  count: I64 @key
}
node Place {
  nums: enum(low, mid, high)
}
edge Near: Place -> Place
edge Links: Place -> Place

