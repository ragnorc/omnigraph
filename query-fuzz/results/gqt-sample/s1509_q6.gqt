    storage: local-filesystem

--- schema
node Place {
  body: [F64]?
  score: [String]?
  name: U64? @unique @index
}
node Doc {
  title: F32?
  text: String @index
  emb: Vector(3)?
}
edge Tagged: Place -> Place {
  since: Date
}

