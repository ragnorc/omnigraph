# issue: none
# notes: query-fuzz gen v1, world seed 1532, case 1; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  level: F64? @index
  content: U64 @index
  count: [I32]?
  age: [Date]?
  vec: [I64]?
}
node Tag {
  weight: Bool?
  flag: String @key
  vec: F64? @index
  nums: Date?
}
node Org {
  age: enum(low, mid, high)?
  vec: Vector(3)
}
node Item {
  flag: [String]
  score: enum(a, b) @index
  weight: Vector(3)?
  size: Vector(3)
  content: Bool
}
node Person {
  body: I64
  name: String @key
  age: F64 @index
  @range(body, -10..1000)
}
edge Near: Org -> Person {
  since: enum(red, green, blue, x-1)?
  @unique(@src, @dst)
}
edge Owns: Tag -> Org {
  w: U32
}

