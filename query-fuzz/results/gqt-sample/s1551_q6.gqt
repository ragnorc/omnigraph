# issue: none
# notes: query-fuzz gen v1, world seed 1551, case 6; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  level: Vector(3)?
  size: I64 @key
}
node Doc {
  born: [I32]
  body: F32?
  rank: Bool
  size: Vector(3)?
  level: I64 @key
}
node Item {
  title: DateTime
  level: Vector(3)
  weight: Blob?
  content: I32 @key
  tags: Date @index
  text: String @index
  @range(content, -10..1000)
}
node Person {
  count: U32 @unique @index
  rank: I64? @unique @index
  content: String?
  weight: I32 @index
}
node Tag {
  code: U32? @index
  rank: Vector(2)
  note: I64 @key
}
edge Near: Doc -> Doc
edge Owns: Person -> Item {
  role: U64
}
edge Cites: Item -> Item

