# issue: none
# notes: query-fuzz gen v1, world seed 1563, case 2; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  nums: [String]
  name: F32
  content: [String]?
  text: String? @index
  emb: Vector(3)?
}
node Org {
  score: [String]?
  born: enum(a, b) @index
  flag: I32 @key
  slug: [I32]?
}
node Place {
  seen: Date? @index
  rank: String
  note: [Bool]?
  level: Date?
}
edge Tagged: Place -> Tag
edge Links: Place -> Tag @card(0..2)
edge Near: Org -> Org {
  since: I32?
  role: U32?
}
edge Wrote: Tag -> Place

