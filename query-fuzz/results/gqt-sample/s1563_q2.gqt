--- query
query q3($arg1: I32, $arg2: Vector(3)) {
  match {
    $p1: Place  $p1 links $t2  $t2 wrote $p3  $p3 tagged $t4  $o5: Org  $o5.born in ["a", "a", "a"] or $o5.flag <= $arg1  $t2.nums contains "dog" and $t2.name > 7.0  fuzzy($t4.text, "cafe", 0)
  }
  return { $t4.name as c0, $p1.seen, $t2.text is not null as b2, count($p3) as a0 }
  order { nearest($t2.emb, $arg2) }
  limit 1
}

