# issue: none
# notes: query-fuzz gen v1, world seed 1599, case 3; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  count: U64 @index
  level: I32 @key
  flag: String @index
  slug: F64
  @range(level, -10..1000)
}
node Person {
  size: Bool @index
  code: F32? @index
}
node Doc {
  born: DateTime
  body: I32
  age: I32
  slug: I64?
  text: String @index
  emb: Vector(3)?
  @range(body, -10..1000)
}
edge Knows: Item -> Item
edge Cites: Doc -> Person {
  role: I32?
}

--- seed
{"type":"Item","data":{"count":9007199254740992,"level":-5,"flag":"data base","slug":3.0}}
