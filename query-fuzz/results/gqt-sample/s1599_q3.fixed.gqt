{"type":"Doc","id":"d2","data":{"born":"1999-12-31T23:59:59Z","body":1,"age":2147483647,"slug":-1,"text":"the and the","emb":null}}
{"type":"Doc","id":"d3","data":{"born":"1999-12-31T23:59:59Z","body":1,"age":100,"slug":4611686018427387904,"text":"Run a fox base","emb":null}}
{"type":"Doc","id":"d4","data":{"born":"2024-02-29T12:00:00Z","body":7,"age":0,"slug":-1,"text":"Dogs a","emb":[-1.0,-1.0,-1.0]}}
{"edge":"Knows","from":"-1","to":"1"}

--- query
query q4($arg1: I32) {
  match { $p1: Person, $d2: Doc, $d2 $e3:cites $p1, $d4: Doc, $d4 $e5:cites $p1, $d4 cites $p6 } where ($d2.age <= $arg1 or $d2.body in [1])
  return { $d4,  $p6,  $p1.size as c2,  avg($p6.code) as a0 }
}

