# issue: none
# notes: query-fuzz gen v1, world seed 1660, case 5; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  weight: [Bool]
  name: F64
  level: Date? @index
  slug: String? @index
  born: Vector(2)?
  @index(weight)
}
node Doc {
  nums: I64 @key
  age: DateTime
}
node Place {
  vec: DateTime @index
}
node Tag {
  seen: enum(a, b)?
  body: F32
  content: Vector(3)?
}
node Item {
  flag: U64
  title: String?
  size: Blob?
  weight: U32 @index
}

--- seed
{"type":"Doc","data":{"nums":3,"age":"2024-02-29T12:00:00Z"}}
{"type":"Place","id":"p0","data":{"vec":"2020-01-01T00:00:00Z"}}
{"type":"Place","id":"p1","data":{"vec":"2020-01-01T00:00:00Z"}}
{"type":"Item","id":"i0","data":{"flag":100,"title":null,"weight":7}}
{"type":"Item","id":"i1","data":{"flag":100,"title":"café","weight":3}}
{"type":"Item","id":"i2","data":{"flag":0,"title":"Ünïcode","size":"base64:SGVsbG8=","weight":0}}
{"type":"Item","id":"i3","data":{"flag":0,"size":"base64:AAEC","weight":4294967295}}
{"type":"Item","id":"i4","data":{"flag":0,"size":"base64:SGVsbG8=","weight":100}}

--- query
query q6($arg1: F32, $arg2: Vector(3)) {
  match {
    $t1: Tag  $t1.body >= 0.5 or $t1.body < $arg1
  }
  return { $t1.content as c0, $t1.@id, $t1.seen in ["b", "a", "a"] as b2, nearest($t1.content, $arg2) }
  order { nearest($t1.content, $arg2), $t1.@id }
  limit 10
}

--- params
{"arg1": 2.5, "arg2": [-0.5, -0.6, -0.5]}

--- expect ordered


--- expect shape
c0: Vector(3)
t1.@id: String
b2: Bool
t1._distance: F32
