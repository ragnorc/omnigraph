# issue: none
# notes: query-fuzz gen v1, world seed 1670, case 18; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  tags: String @key
  weight: Blob?
}
node Place {
  vec: enum(a, b)? @index
  weight: I64 @index
  seen: [String]?
  note: F64
  size: DateTime @index
  @range(weight, -10..1000)
}
node Org {
  score: I64
  age: I32
  note: [Date]
  @key(score, age)
  @index(note)
}
node Person {
  content: String @key
  size: enum(a, b)? @index
  name: U64? @unique
}
node Tag {
  content: enum(red, green, blue, x-1)
}
edge Links: Place -> Tag @card(0..1)

--- seed
