# issue: none
# notes: query-fuzz gen v1, world seed 1704, case 13; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  content: DateTime @index
  score: Vector(2)?
  rank: String?
  born: F32
}
node Doc {
  slug: [I32]
  count: F32
  note: I32? @unique
  born: String @index
  @index(slug)
}
node Person {
  note: I32 @key
  size: [Bool]?
  slug: U32 @index
}
edge Wrote: Person -> Person
edge Links: Doc -> Doc
edge Cites: Person -> Person {
  weight: [Date]
}

