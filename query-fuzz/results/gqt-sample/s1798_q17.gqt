# issue: none
# notes: query-fuzz gen v1, world seed 1798, case 17; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  tags: enum(red, green, blue, x-1)? @unique @index
  body: F32? @index
}
node Person {
  rank: I32 @key
  code: [F64]?
  flag: F64?
  note: DateTime?
  @index(code)
}
node Place {
  nums: I64 @key
  seen: I64? @index
}
edge Links: Person -> Place {
  role: I32?
  since: String?
}
edge Near: Person -> Place
edge Tagged: Person -> Org
edge Owns: Place -> Place @card(0..1)

