# issue: none
# notes: query-fuzz gen v1, world seed 1844, case 18; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  code: I64
  note: [Date]?
  rank: String
  text: String @index
  emb: Vector(3)
}
node Item {
  name: U64 @index
  content: F64? @index
  seen: I64 @key
}
node Org {
  code: Bool?
}
edge Near: Person -> Org {
  role: I32?
}
edge Cites: Item -> Org {
  weight: [Bool]?
  role: I32?
  @unique(@src, @dst)
}
edge Links: Item -> Item {
  since: Bool?
}
edge Likes: Person -> Org @card(0..2) {
  role: String?
}

