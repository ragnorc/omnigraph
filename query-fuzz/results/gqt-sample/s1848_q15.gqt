# issue: none
# notes: query-fuzz gen v1, world seed 1848, case 15; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  age: I32?
}
node Person {
  title: enum(a, b)?
  size: Bool?
  born: F64? @index
  code: U64
  slug: I32? @index
  @range(slug, -10..1000)
}
node Place {
  name: I64 @key
  level: Vector(3)?
}
node Doc {
  vec: String? @unique @index
}
node Tag {
  seen: Bool
  nums: String?
  note: enum(a, b)?
}
edge Near: Tag -> Person {
  since: [String]
  role: U32
}
edge Links: Doc -> Doc {
  weight: I64
  w: Date?
}
edge Knows: Person -> Person {
  @key(@src, @dst)
}
edge Owns: Place -> Person {
  since: I64
  role: I32
}

