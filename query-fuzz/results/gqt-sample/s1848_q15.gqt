--- query
query terms($arg1: String) {
  match {
    $d1: Doc
    $d1 links $d2
    $d1.vec < "café" or $d1.vec >= $arg1
  }
  return { $d1.vec }
  order { $d1.vec }
}

--- params
{"arg1": "and the"}

--- expect ordered
{"d1.vec": "running dogs"}
{"d1.vec": "running dogs"}

--- expect shape
d1.vec: String
