# issue: none
# notes: query-fuzz gen v1, world seed 1964, case 18; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  name: String @unique
  note: Blob?
  age: DateTime? @index
  score: I64 @key
  title: [F64]?
  @index(title)
}
node Org {
  level: Blob?
  size: [F64]?
  @index(size)
}
node Place {
  tags: F64 @index
  rank: F32?
}
node Person {
  size: U64 @index
  born: String @key
  note: enum(red, green, blue, x-1)?
  age: [Bool]?
  vec: [F64]?
  @index(age)
}
edge Likes: Doc -> Doc

