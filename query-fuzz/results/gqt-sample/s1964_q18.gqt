--- query
query q19($arg1: F64) {
  match {
    $o1: Org
    $d2: Doc
    $arg1 in $o1.size
    $d2.name <= "ab" or $d2.title contains 3.0
  }
  return { $o1.size  $d2.title as c1 }
  order { c1 asc }
  limit 10
}

