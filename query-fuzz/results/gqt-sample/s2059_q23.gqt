--- query
query q24() {
  match {
    $p1: Person
    $p1.flag contains "R"
    $p1.flag starts_with "data" or not $p1.note
    not { $p1.flag in ["a", "dog", "x y z"] }
  }
  return { $p1.emb  $p1.note }
}

--- expect unordered


--- expect shape
p1.emb: Vector(3)
p1.note: Bool
