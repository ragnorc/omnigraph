# issue: none
# notes: query-fuzz gen v1, world seed 2059, case 23; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  size: F64 @index
  note: Bool @index
  flag: String @key
  text: String? @index
  emb: Vector(3)?
  @range(size, -10..1000)
}
node Item {
  content: Vector(2)
}
node Org {
  age: enum(a, b)
  code: U32
}
edge Cites: Item -> Item

