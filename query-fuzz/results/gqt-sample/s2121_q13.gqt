# issue: none
# notes: query-fuzz gen v1, world seed 2121, case 13; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  name: String @key
  vec: Blob?
  born: enum(a, b)?
}
node Tag {
  slug: Blob?
  seen: enum(a, b)? @index
  nums: Date
  born: U32?
  text: String? @index
  emb: Vector(3)
}
edge Owns: Tag -> Person {
  weight: Bool
}
edge Tagged: Tag -> Person @card(0..1)
edge Cites: Tag -> Tag {
  w: [String]
}
edge Wrote: Tag -> Tag @card(0..1) {
  role: String?
  weight: F32?
}

--- seed
{"type":"Person","data":{"name":"x","vec":"base64:AAEC","born":"b"}}
{"type":"Person","data":{"name":"dog house","vec":"base64:"}}
{"type":"Person","data":{"name":"dog","vec":null,"born":"b"}}
