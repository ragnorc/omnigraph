--- query
query q14($arg1: String) {
  match {
    $p1: Person { born: "b" }
    $p1.born = $arg1 and $p1.name < "and the"
    not (fuzzy($p1.name, "a"))
  }
  return distinct { $p1.born, $p1.@id }
  order { bm25($p1.name, "run") desc }
}

--- params
{"arg1": "a"}

