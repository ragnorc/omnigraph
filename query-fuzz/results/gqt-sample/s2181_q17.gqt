--- schema
node Org {
  name: Date
  body: F32 @index
  vec: I32 @key
  score: U32?
  @range(vec, -10..1000)
}
node Item {
  code: I64 @index
  nums: I32
  age: Bool? @index
  size: I64? @index
  flag: DateTime?
  @key(code, nums)
}
edge Cites: Org -> Item

