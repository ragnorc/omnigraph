--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  count: Bool? @index
  name: F64
}
node Item {
  title: [String]?
  slug: String?
  nums: I64
  rank: I64 @index
  level: String
  @key(nums, level)
}
node Tag {
  slug: I32 @key
  rank: [I32]
  count: [Date]
  vec: DateTime?
}
edge Knows: Person -> Tag

