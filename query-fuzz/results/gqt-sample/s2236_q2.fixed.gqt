# issue: none
# notes: query-fuzz gen v1, world seed 2236, case 2; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  count: I64 @unique @index
  tags: Bool? @index
  code: [F64]?
  score: [String]?
  body: enum(a, b) @index
}
node Org {
  code: Blob?
  born: String? @index
  name: String
}
node Place {
  level: [I32]?
  content: DateTime?
  tags: [Date]?
  @index(tags)
}
edge Links: Doc -> Org {
  @key(@src, @dst)
}
edge Cites: Org -> Doc {
  w: String?
}
edge Knows: Place -> Place {
  w: F64?
}

