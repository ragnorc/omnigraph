--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  name: Blob?
  title: I32 @index
  score: String? @index
  born: Blob?
  seen: I32 @key
}
node Doc {
  rank: U32?
  seen: Vector(3)?
  count: enum(low, mid, high)
  note: String
}
edge Near: Item -> Item {
  @key(@src, @dst)
}

