--- query
query q16() {
  match {
    $i1: Item
    $i1.title in [1, 2, 2147483647]
  }
  return { $i1 as c0  $i1.seen as c1  $i1.score  bm25($i1.score, "fox") as r }
  order { bm25($i1.score, "fox"), c0 }
  limit 10
}

