# issue: none
# notes: query-fuzz gen v1, world seed 2322, case 16; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  body: U64 @index
  name: U64? @index
  born: U64
  title: String?
  level: Date? @index
}
node Item {
  code: [String]
  body: I64 @key
  score: Bool? @index
  flag: DateTime? @index
  text: String @index
  emb: Vector(3)
}
node Org {
  nums: Vector(2)?
  tags: String
  seen: String
  @key(tags, seen)
}
node Doc {
  title: I32 @index
  tags: Vector(2)
  nums: DateTime
  @range(title, -10..1000)
}
edge Cites: Doc -> Org {
  role: [String]?
  @key(@src, @dst)
}

