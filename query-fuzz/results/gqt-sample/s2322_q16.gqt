--- query
query q17() {
  match {
    $o1: Org
    $d2: Doc
    $o1 $e3:cites $d2
    $o4: Org
    $d2 $e5:cites $o4
    $o6: Org
    $d2 cites $o6
    not ($e3.role is not null)
  }
  return { $d2.@id, $e5.role }
  limit 3
}

--- expect unordered


--- expect shape
d2.@id: String
e5.role: [String]
