# issue: none
# notes: query-fuzz gen v1, world seed 2443, case 4; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  count: Blob?
  slug: Vector(2)
  rank: [I32]
  note: String @key
  name: [F64]?
}
node Person {
  content: [F64]
  title: Vector(3)
}
node Tag {
  name: DateTime
  age: I64? @index
  flag: I32
  count: enum(a, b)? @index
  @range(age, -10..1000)
}
edge Knows: Person -> Person
edge Likes: Org -> Person {
  w: String?
}
edge Owns: Org -> Tag {
  @key(@src, @dst)
}

