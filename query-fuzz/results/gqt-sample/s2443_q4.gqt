--- query
query q5($arg1: Vector(3)) {
  match {
    $o1: Org
    $o1 likes $p2
    $p3: Person
    $p2 knows $p3
    count { $p4: Person  $o1 likes $p4 } > 0
    match_text($o1.note, "dgo")
  }
  return { $p2.title  $o1.note as c1  $p3.@id }
  order { rrf(nearest($p2.title, $arg1), bm25($o1.note, "dog")) desc }
  limit 1
}

--- params
{"arg1": [0.4, 0.4, 0.4]}

