# issue: none
# notes: query-fuzz gen v1, world seed 2539, case 11; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  title: I64
  text: String? @index
  emb: Vector(3)?
  @range(title, -10..1000)
}
node Org {
  body: U64?
  name: U64
  size: Date
}
node Person {
  title: DateTime
  note: String @key
}
node Place {
  slug: I32?
  born: Bool
  title: Date?
  level: F64?
  flag: [I32]?
}
node Doc {
  nums: String @key
  tags: U32?
  rank: I32? @index
  slug: F32
}
edge Likes: Doc -> Item
edge Cites: Doc -> Item
edge Links: Org -> Org {
  w: F32
}

