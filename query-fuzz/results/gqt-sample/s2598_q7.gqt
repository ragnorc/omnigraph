# issue: none
# notes: query-fuzz gen v1, world seed 2598, case 7; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  seen: I32?
  rank: String
  score: String @index
  @key(rank, score)
}
node Item {
  flag: enum(a, b)?
  title: Blob?
  name: enum(low, mid, high)?
  score: F64?
}
node Tag {
  tags: U32? @index
  age: enum(red, green, blue, x-1)?
  flag: String @key
  score: F32? @index
}
node Org {
  weight: Vector(3)?
  size: [Date]?
  nums: F64?
  vec: F64?
  level: String @key
  @range(vec, -10..1000)
}
edge Links: Tag -> Item
edge Knows: Tag -> Tag {
  w: enum(low, mid, high)
}

