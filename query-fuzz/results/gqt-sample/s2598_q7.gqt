--- query
query q8($arg1: F64) {
  match {
    $o1: Org { vec: $arg1 }
    $o1.nums != 1.5 or $o1.nums <= 10000000000.0
    $o1.vec is not null
  }
  return { $o1.size, $o1.weight, max($o1.vec) as a0 }
  order { a0 desc, $o1.@id }
}

