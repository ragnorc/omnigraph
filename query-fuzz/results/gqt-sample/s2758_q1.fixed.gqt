# issue: none
# notes: query-fuzz gen v1, world seed 2758, case 1; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  score: F64
  level: [String]?
  age: I32
  nums: String @index
  @key(age, nums)
  @range(score, -10..1000)
}
node Item {
  rank: Bool
  size: Vector(3)
  flag: I64 @key
  text: String @index
}
edge Near: Item -> Item
edge Knows: Item -> Place {
  role: F64
}

