--- mutate
query q2($arg1: I32, $arg2: Bool, $arg3: Vector(3), $arg4: I64) {
  match { $x: Place } where $x.age != $arg1  update $x set { score: 0.1 }
  insert Item { rank: $arg2, size: $arg3, flag: $arg4, text: "a" }
}

--- params
{"arg1": -1, "arg2": true, "arg3": [1.0, -0.9, -0.6], "arg4": 9007199254740993}

