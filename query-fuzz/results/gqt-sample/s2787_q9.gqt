# issue: none
# notes: query-fuzz gen v1, world seed 2787, case 9; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  slug: F64? @index
  name: enum(low, mid, high)?
  body: enum(a, b)? @unique @index
  rank: I32 @index
  seen: Blob?
  text: String? @index
  emb: Vector(3)?
}
node Org {
  body: I32? @index
}
node Doc {
  body: Bool @index
  flag: [Bool]?
  weight: Date
  @index(flag)
}
node Item {
  body: Blob?
  age: F32? @index
  code: [String]?
  seen: [F64]
  @index(seen)
}
edge Tagged: Doc -> Org

