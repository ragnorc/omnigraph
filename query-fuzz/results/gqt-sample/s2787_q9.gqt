--- query
query q10($arg1: I32, $arg2: [I32], $arg3: [I32]) {
  match {
    $o1: Org { body: $arg1 }
    $o1 tagged $d2
    $o3: Org
    $d2 tagged $o3
    $o1.body in $arg2 and $o1.body in $arg3
  }
  return { $o1.@id  $o1.body as c1 }
}

