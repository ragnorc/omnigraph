  w: enum(a, b)?
  weight: I32?
}
edge Wrote: Tag -> Tag

--- seed

--- mutate
query q2($arg1: Bool) {
  insert Tag { flag: $arg1 title: 3 }
  insert Tag { flag: true title: 0.0 }
}

