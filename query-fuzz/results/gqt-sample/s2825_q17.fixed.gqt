{"edge":"Cites","from":"7","to":"7","data":{"w":3}}
{"edge":"Cites","from":"0","to":"0","data":{"w":7,"role":true}}
{"edge":"Cites","from":"2","to":"-1","data":{"w":0,"role":false}}
{"edge":"Cites","from":"-1","to":"7","data":{"w":7}}
{"edge":"Cites","from":"7","to":"-1","data":{"role":true}}

--- mutate
query q18($arg1: U64, $arg2: String, $arg3: Vector(3)) {
  match { $x: Tag } where $x.rank < 7  update $x set { vec: "of the and" }
  insert Doc { score: $arg1, slug: 3.0, text: $arg2, emb: $arg3 }
}

