# issue: none
# notes: query-fuzz gen v1, world seed 2827, case 19; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  score: I64 @key
  born: Bool? @index
  age: [F64]?
  @index(age)
}
edge Cites: Place -> Place @card(0..1) {
  weight: String
  w: F64?
}
edge Likes: Place -> Place {
  w: String?
}
edge Wrote: Place -> Place {
  w: I32?
}
edge Tagged: Place -> Place {
  @unique(@src, @dst)
}

