--- mutate
query q20($arg1: I64, $arg2: [F64]) {
  insert Place { score: $arg1, age: $arg2 }
}

--- params
{"arg1": -1, "arg2": [1.5, -2.25]}

--- expect affected: nodes=1 edges=0
