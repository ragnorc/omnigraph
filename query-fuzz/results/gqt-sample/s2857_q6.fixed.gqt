# issue: none
# notes: query-fuzz gen v1, world seed 2857, case 6; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  age: U64? @index
}
node Tag {
  weight: F32
  rank: String @key
}
node Org {
  age: [F64]
  nums: F64
  content: I32 @key
  @index(age)
}
node Place {
  title: F64?
  weight: enum(low, mid, high)? @index
  @range(title, -10..1000)
}
edge Likes: Org -> Place

