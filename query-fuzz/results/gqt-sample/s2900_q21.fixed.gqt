# issue: none
# notes: query-fuzz gen v1, world seed 2900, case 21; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  vec: String?
  rank: enum(red, green, blue, x-1)?
  tags: DateTime? @index
}
node Person {
  slug: enum(low, mid, high)
}
node Item {
  count: I32?
  born: I32? @index
  level: I32
  code: F64
  name: [I64]
  @index(name)
}
node Doc {
  level: enum(red, green, blue, x-1)?
  vec: Vector(3)
}
node Org {
  score: I32 @key
  size: enum(low, mid, high)?
}
edge Links: Doc -> Item

