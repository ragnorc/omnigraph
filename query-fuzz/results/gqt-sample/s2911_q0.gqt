--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  body: U64? @index
}
node Item {
  name: I32
  code: I64
  @key(name, code)
}
node Tag {
  count: I32 @key
  content: Vector(2)
  weight: [Bool]
  rank: [I32]
  body: I64? @index
  text: String @index
}
edge Cites: Item -> Place
edge Links: Item -> Place

