# issue: none
# notes: query-fuzz gen v1, world seed 3028, case 12; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  nums: [F64]?
  size: [Date]?
  count: String? @index
}
node Doc {
  born: [I32]
  @index(born)
}
node Org {
  level: Bool
  count: U32 @index
  note: [I32]?
}
node Item {
  count: U32
  nums: String @key
}
edge Links: Item -> Org {
  since: I32
}

--- seed
{"type":"Place","id":"p0","data":{"nums":[0.1],"size":["2020-01-01"],"count":"x"}}
{"type":"Place","id":"p1","data":{"size":null,"count":"x y z"}}
{"type":"Place","id":"p2","data":{"size":["2020-01-01"],"count":"x"}}
{"type":"Doc","id":"d0","data":{"born":[42]}}
{"type":"Doc","id":"d1","data":{"born":[0,-2147483648,0]}}
{"type":"Doc","id":"d2","data":{"born":[0,100,0]}}
{"type":"Doc","id":"d3","data":{"born":[0]}}
{"type":"Org","id":"o0","data":{"level":true,"count":3,"note":null}}
{"type":"Org","id":"o1","data":{"level":true,"count":2,"note":null}}
{"type":"Org","id":"o2","data":{"level":false,"count":0,"note":[-5,42,2147483647]}}
{"type":"Item","data":{"count":42,"nums":"fox"}}
{"type":"Item","data":{"count":0,"nums":"Ünïcode"}}
{"type":"Item","data":{"count":2,"nums":"run"}}
{"type":"Item","data":{"count":42,"nums":"running"}}
{"edge":"Links","from":"running","to":"o2","data":{"since":3}}
{"edge":"Links","from":"fox","to":"o1","data":{"since":42}}

--- query
query q13($arg1: U32) {
  match {
    $i1: Item { count: $arg1 }
    $o2: Org
    $i1 $e3:links $o2
    $o2.count in [3, 7, 3]
  }
  return { $o2.level, $o2, bm25($i1.nums, "dog") }
  order { bm25($i1.nums, "dog") }
  limit 10
}

--- params
{"arg1": 0}

--- expect ordered


--- expect shape
o2.level: Bool
o2: Org
i1._score: F32
