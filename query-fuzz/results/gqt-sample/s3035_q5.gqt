# issue: none
# notes: query-fuzz gen v1, world seed 3035, case 5; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  content: I32 @key
  name: Blob?
  rank: Vector(2)
}
node Place {
  count: [String]?
  born: Vector(2)?
  seen: Vector(2)
  text: String? @index
  @index(count)
}
node Person {
  body: String?
  born: [String]
  size: I64 @key
  @index(born)
}

