# issue: none
# notes: query-fuzz gen v1, world seed 3123, case 6; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  note: I32? @index
  @range(note, -10..1000)
}
node Place {
  nums: String?
  rank: I32? @index
  body: [Bool]?
  @index(body)
}
node Doc {
  count: U32? @index
  text: String? @index
  emb: Vector(3)?
}
node Org {
  vec: I32?
  score: enum(red, green, blue, x-1)?
}

