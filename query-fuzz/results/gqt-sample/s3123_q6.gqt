--- query
query q7($arg1: Vector(3)) {
  match {
    $d1: Doc
    $d1.nosuch is null or $d1.count in [0, 1]
    count { $d1.count in [1, 4294967295, 4294967295] } < 2
  }
  return { $d1.text, nearest($d1.emb, $arg1) as r }
  order { nearest($d1.emb, $arg1) }
  limit 5
}

