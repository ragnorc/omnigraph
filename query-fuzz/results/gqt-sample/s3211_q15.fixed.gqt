--- query
query q16() {
  match { $p1: Person, $p2: Person, $p1 tagged{2,3} $p2, $p2 <likes> $p3 } where exists { $p4: Person, $p2 owns $p4 where $p4.score in [9007199254740992] } and $p3.score > 0
  return { $p1.score as c0 }
  order { c0 desc }
  limit 10
}

