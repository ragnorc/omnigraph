--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  code: F64 @index
  vec: enum(a, b)?
  count: String @key
}
node Item {
  tags: F32?
  flag: Vector(3)?
  slug: I32 @unique
  level: String? @index
  vec: I32? @unique
}
node Tag {
  flag: DateTime @index
  title: [Bool]?
  seen: Bool? @index
  code: Vector(3)
  rank: Vector(3)
}
node Person {
  title: U64
  weight: U64 @index
  seen: Vector(3)?
}

