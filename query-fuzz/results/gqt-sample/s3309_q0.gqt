{"edge":"Knows","from":"o2","to":"0"}
{"edge":"Knows","from":"o2","to":"0"}
{"edge":"Knows","from":"o1","to":"0"}
{"edge":"Cites","from":"o0","to":"p1","data":{"w":"running"}}
{"edge":"Cites","from":"o1","to":"p0","data":{"w":"dog"}}
{"edge":"Cites","from":"o2","to":"p7","data":{"w":"x y z"}}
{"edge":"Cites","from":"o3","to":"p2","data":{"w":"database"}}

--- query
query q1($arg1: [I32], $arg2: [I32], $arg3: String, $arg4: String, $arg5: [I32], $arg6: String) {
  match {
    $p1: Person { content: "a" }  $o2: Org  $p1 $e3:cites $o2  $o2.tags in $arg1 and $o2.tags in $arg2  $e3.w <= $arg3 and $e3.w starts_with "a"  match_text($p1.body, $arg4)
  }
  return { $p1.content, $o2.tags in $arg5 as b1 }
  order { $p1.content asc }
}

--- params
{"arg1": [-1], "arg2": [-1], "arg3": "Run", "arg4": "the and", "arg5": [1, -1, -1], "arg6": "x y z"}

--- expect ordered


--- expect shape
p1.content: String
b1: Bool
