--- query
query q20() {
  match {
    $i1: Item { nums: date("1970-01-01") }
    $i1 tagged{1,3} $i2
    $i2.nums in [date("1970-01-01")] or $i2.nums in [date("2020-01-01"), date("2020-01-01"), date("1970-01-01")]
  }
  return { $i1.nums }
  limit 2
}

