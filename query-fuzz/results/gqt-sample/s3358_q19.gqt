# issue: none
# notes: query-fuzz gen v1, world seed 3358, case 19; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  size: enum(low, mid, high)?
  vec: [Date]?
  weight: String @key
  text: String @index
  emb: Vector(3)?
  @index(vec)
}
node Item {
  nums: Date?
}
node Place {
  rank: U64? @index
  title: F32
}
edge Tagged: Item -> Item

