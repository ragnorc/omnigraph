# issue: none
# notes: query-fuzz gen v1, world seed 3372, case 13; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  count: [String]?
  size: I64?
  content: Blob?
  flag: String
  code: DateTime @index
  @index(count)
}
node Person {
  body: I32? @index
  count: DateTime
  size: String @key
  code: String? @unique
  text: String? @index
  emb: Vector(3)
  @range(body, -10..1000)
}
node Item {
  score: enum(low, mid, high)?
  tags: enum(red, green, blue, x-1) @index
  body: F64?
}
edge Owns: Item -> Item {
  weight: U64?
  w: F64
  @unique(@src, @dst)
}
edge Tagged: Item -> Item

