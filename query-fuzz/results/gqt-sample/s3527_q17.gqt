# issue: none
# notes: query-fuzz gen v1, world seed 3527, case 17; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  nums: Blob?
  note: I64 @index
  size: String @key
}
edge Tagged: Item -> Item {
  since: DateTime
  @unique(@src, @dst)
}
edge Knows: Item -> Item {
  weight: String?
  since: I32?
}

