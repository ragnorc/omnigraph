--- query
query q18($arg1: I64) {
  match {
    $i1: Item  $i2 tagged $i1  $i3 tagged{1,1} $i1  $i4: Item  $i1 $e5:tagged $i4  $i3.note = $arg1  match_text($i4.size, "hello world") = true
  }
  return { $i1.size, $i3.size, avg($i4.note) as a0 }
  order { bm25($i2.size, "rnu") desc }
  limit 3
}

