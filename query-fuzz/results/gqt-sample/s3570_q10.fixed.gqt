# issue: none
# notes: query-fuzz gen v1, world seed 3570, case 10; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  vec: enum(a, b)?
  age: F64
  level: Blob?
  nums: [I32]?
  score: String @key
  text: String? @index
  emb: Vector(3)
  @range(age, -10..1000)
}
edge Owns: Tag -> Tag {
  weight: I64
}

