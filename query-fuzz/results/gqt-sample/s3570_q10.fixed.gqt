--- query
query q11() {
  match { $t1: Tag, $t1 <owns> $t2 } where count { $t3: Tag, $t3 owns $t1 where contains($t3.text, "and ") } = 1
  return { $t2 as c0,  $t1.vec }
  order { $t1.vec desc }
}

--- expect ordered
{"c0": {"@id": "Hello World", "age": 1.5, "nums": [-5, 3], "score": "Hello World", "text": "fox dog", "vec": "b"}}
{"c0": {"@id": "run", "age": 2.5, "nums": [42, 0], "score": "run", "text": "and the café", "vec": "a"}}

