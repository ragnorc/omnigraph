--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  weight: U64? @index
  code: U32?
}
node Org {
  body: U64? @index
  note: Blob?
  rank: I32
}
edge Wrote: Org -> Doc
edge Knows: Doc -> Doc
edge Tagged: Org -> Doc {
  w: U32?
  since: I64
}

--- seed
{"type":"Doc","id":"d0","data":{"weight":2147483647,"code":null}}
{"type":"Doc","id":"d1","data":{"weight":0,"code":null}}
{"type":"Org","id":"o0","data":{"body":0,"note":"base64:AAEC","rank":100}}
{"edge":"Wrote","from":"o0","to":"d1"}
{"edge":"Wrote","from":"o0","to":"d1"}
{"edge":"Wrote","from":"o0","to":"d0"}
{"edge":"Wrote","from":"o0","to":"d1"}
{"edge":"Wrote","from":"o0","to":"d1"}
{"edge":"Wrote","from":"o0","to":"d1"}
{"edge":"Knows","from":"d0","to":"d1"}
{"edge":"Knows","from":"d0","to":"d0"}
{"edge":"Knows","from":"d0","to":"d1"}
{"edge":"Knows","from":"d1","to":"d1"}
{"edge":"Knows","from":"d1","to":"d1"}
