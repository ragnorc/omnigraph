# issue: none
# notes: query-fuzz gen v1, world seed 3700, case 20; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  vec: String @key
  title: I64?
  slug: String?
  @range(title, -10..1000)
}
node Tag {
  weight: String?
  title: enum(a, b) @index
  age: [String]
  level: String @key
}
node Item {
  age: String @key
  weight: Vector(3)?
  body: Blob?
}
node Place {
  flag: Vector(3)?
  weight: String @index
  body: I64?
}
node Doc {
  note: I32?
  flag: [I32]
  tags: enum(low, mid, high)? @index
  nums: String @key
  score: F64? @index
  @index(flag)
}
edge Likes: Person -> Person {
  @key(@src, @dst)
}
edge Links: Person -> Place {
  weight: I64?
  role: Date
}

