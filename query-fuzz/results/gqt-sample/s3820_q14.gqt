--- query
query q15() {
  match {
    $i1: Item
    $i1.text in ["running fox Dogs a", "Hello World", "naïve"] and $i1.body > 3.0
    $i1.text contains "a" and $i1.body > 10000000000.0
  }
  RETURN distinct { $i1.text  $i1.text contains "the " as b1  bm25($i1.text, "run") as r }
  order { bm25($i1.text, "run") desc }
  limit 1
}

