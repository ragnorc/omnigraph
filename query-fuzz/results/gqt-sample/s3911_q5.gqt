# issue: none
# notes: query-fuzz gen v1, world seed 3911, case 5; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  weight: String @key
  flag: [I32]
  size: DateTime? @index
  slug: [Date]?
  vec: F32? @index
}
node Tag {
  size: I64 @key
  vec: enum(low, mid, high) @index
}
edge Knows: Tag -> Tag {
  w: Date
  @key(@src, @dst)
}

