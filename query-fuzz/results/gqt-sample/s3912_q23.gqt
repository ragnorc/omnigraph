# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  nums: I32
  seen: DateTime?
  level: I64 @key
  count: Vector(2)?
  vec: I32?
}
node Person {
  slug: String
  tags: String? @index
}
node Doc {
  tags: F64?
  born: I64 @key
  slug: Blob?
  body: [Date]?
  flag: [I64]
  @index(flag)
  @range(born, -10..1000)
}
edge Near: Person -> Person @card(0..2)
edge Wrote: Person -> Item {
  weight: I64?
  role: I32
}

