# issue: none
# notes: query-fuzz gen v1, world seed 3962, case 9; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  seen: [I64]?
  rank: [F64]
  nums: [String]
  flag: enum(red, green, blue, x-1)?
  code: Bool?
  @index(nums)
}
node Item {
  body: F32
  title: String @key
  name: I64? @index
  @range(name, -10..1000)
}
edge Cites: Place -> Place {
  since: [String]?
  weight: Date?
}
edge Near: Place -> Place {
  since: [I64]?
  role: I32?
}
edge Wrote: Place -> Place {
  weight: I64?
  since: I32
}
edge Knows: Place -> Place @card(0..2) {
  role: I32?
}

