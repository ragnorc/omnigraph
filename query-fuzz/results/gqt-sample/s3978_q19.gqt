--- schema
node Doc {
  flag: String? @index
  note: U64? @index
  score: enum(a, b) @index
}
node Item {
  rank: I64
  note: String @index
  content: Date @unique @index
  count: [Bool]
  name: [I32]?
  @index(count)
}

