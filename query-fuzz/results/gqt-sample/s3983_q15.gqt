# issue: none
# notes: query-fuzz gen v1, world seed 3983, case 15; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  flag: I64 @key
  born: Date? @unique
  name: enum(a, b)? @index
  text: String @index
  emb: Vector(3)?
}
node Org {
  size: String @key
  seen: U32
  flag: Vector(2)
}
edge Owns: Person -> Person
edge Near: Org -> Org {
  role: String?
}
edge Cites: Person -> Person @card(0..1)
edge Likes: Org -> Org {
  weight: [F64]?
  @key(@src, @dst)
}

