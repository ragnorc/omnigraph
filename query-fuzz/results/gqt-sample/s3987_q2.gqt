--- query
query q3() {
  match {
    $p1: Person
    $p1.title in [9007199254740992, 4611686018427387904, 2] and $p1.title in [3]
    exists { $p1.title = 3 }
  }
  return distinct { $p1, $p1.@id as c1 }
  limit 2
}

