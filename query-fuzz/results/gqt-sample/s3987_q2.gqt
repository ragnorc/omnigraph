# issue: none
# notes: query-fuzz gen v1, world seed 3987, case 2; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  note: enum(low, mid, high)? @index
}
node Person {
  title: I64
  @range(title, -10..1000)
}
node Place {
  nums: Vector(3)?
}
node Org {
  score: U64
}
node Tag {
  flag: enum(a, b) @index
  born: String @index
  seen: Vector(2)
  vec: [String]?
  text: String @index
}
edge Tagged: Person -> Place
edge Wrote: Person -> Person {
  w: I32?
  since: enum(a, b)?
}

