# issue: none
# notes: query-fuzz gen v1, world seed 4082, case 4; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  slug: Vector(3)?
  count: Blob?
  flag: Bool
}
node Person {
  code: String?
  score: I64 @index
}
node Tag {
  content: F64
  code: Blob?
}
node Org {
  tags: Vector(2)
}
node Item {
  nums: [String]?
  content: Bool
  seen: Vector(3)?
  tags: I64 @key
  @index(nums)
}
edge Wrote: Org -> Org {
  since: enum(red, green, blue, x-1)?
  weight: F64?
}

