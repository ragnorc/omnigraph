# issue: none
# notes: query-fuzz gen v1, world seed 4116, case 7; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  vec: Blob?
}
node Person {
  weight: enum(a, b)? @index
  content: DateTime? @index
  name: enum(a, b)? @index
  size: F64? @index
}
edge Wrote: Person -> Person {
  w: enum(a, b)
  role: Date?
}
edge Owns: Person -> Person

