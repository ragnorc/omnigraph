--- query
query q16() {
  match {
    $d1: Doc
    $d1 wrote $d2
    $d2.nums in [date("2020-01-01"), date("1970-01-01")] and $d2.tags is not null
  }
  return { $d1.tags }
  order { $d1.tags }
}

--- expect ordered
{"d1.tags": "low"}

--- expect shape
d1.tags: String
