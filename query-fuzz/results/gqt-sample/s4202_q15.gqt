# issue: none
# notes: query-fuzz gen v1, world seed 4202, case 15; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  code: Blob?
  tags: enum(low, mid, high)?
  nums: Date @index
  count: enum(low, mid, high)?
}
node Item {
  title: enum(red, green, blue, x-1)?
  vec: [F64]?
  content: enum(red, green, blue, x-1)? @index
}
node Tag {
  title: DateTime? @index
  nums: DateTime? @index
  code: I64 @unique
  flag: I64
  age: Bool?
}
node Org {
  weight: enum(red, green, blue, x-1)? @index
  body: I64 @key
  seen: Date? @index
}
edge Likes: Org -> Tag
edge Near: Org -> Org
edge Wrote: Doc -> Doc
edge Cites: Org -> Tag

