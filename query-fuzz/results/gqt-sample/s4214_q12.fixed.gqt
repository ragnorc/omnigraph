# issue: none
# notes: query-fuzz gen v1, world seed 4214, case 12; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  note: Date
  vec: U32 @index
  code: String @key
  body: DateTime? @index
}
node Person {
  nums: I64 @unique
  flag: F64? @index
  level: String? @unique
  seen: Blob?
}
node Org {
  nums: [I64]?
}
node Item {
  weight: F64? @index
  count: enum(low, mid, high)?
  text: String? @index
  emb: Vector(3)
  @range(weight, -10..1000)
}

