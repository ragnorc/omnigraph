# issue: none
# notes: query-fuzz gen v1, world seed 4234, case 20; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  born: String @key
  body: F64?
  count: enum(red, green, blue, x-1)
  code: [String]?
  content: Blob?
  @index(code)
}
node Item {
  born: Vector(2)?
}
edge Owns: Org -> Item
edge Knows: Item -> Item
edge Near: Item -> Org {
  @unique(@src, @dst)
}
edge Likes: Item -> Item {
  @unique(@src, @dst)
}

