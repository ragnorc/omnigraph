{"edge":"Likes","from":"i5","to":"i4"}

--- query
query q21($arg1: Date) {
  match {
    $i1: Item
    $i1 near $o2
  }
  return distinct { $o2.@id as c0 }
  order { c0 }
}

--- params
{"arg1": "1970-01-01"}

--- expect ordered
{"c0": "Dogs"}
{"c0": "ran"}
{"c0": "the"}
{"c0": "x y z"}

--- expect shape
c0: String
