--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  vec: enum(a, b)
  code: [I32]
  born: [I32]
  @index(code)
}
node Item {
  count: Blob?
  text: String? @index
  emb: Vector(3)
}

