--- query
query search($arg1: String) {
  match {
    $d1: Doc { age: $arg1 }
    $d1.age contains "r"
  }
  return { $d1.born as c0, $d1.@id as c1 }
  order { c0 asc, c1 asc }
  limit 1
}

--- params
{"arg1": "fox"}

--- expect ordered


--- expect shape
c0: U32
c1: String
