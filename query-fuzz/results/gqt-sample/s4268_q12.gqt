# issue: none
# notes: query-fuzz gen v1, world seed 4268, case 12; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  slug: Blob?
}
node Person {
  title: Date?
  text: String? @index
  emb: Vector(3)?
}
node Tag {
  slug: I32 @key
  vec: [String]?
  tags: I32
  @range(slug, -10..1000)
}
node Doc {
  age: String @key
  born: U32
  code: Vector(3)
}
edge Cites: Org -> Org

