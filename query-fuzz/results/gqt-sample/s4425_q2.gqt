# issue: none
# notes: query-fuzz gen v1, world seed 4425, case 2; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  vec: Bool?
  body: [I64]?
  rank: Bool @index
  code: U64? @unique
  flag: String?
  @index(body)
}
node Person {
  name: I64
  code: String @key
  born: [I64]?
  weight: I64 @index
  flag: Blob?
  text: String @index
  emb: Vector(3)?
  @range(weight, -10..1000)
}
edge Wrote: Person -> Item {
  role: [I64]?
  since: F64?
}
edge Near: Person -> Person {
  role: I32?
}
edge Knows: Person -> Item

