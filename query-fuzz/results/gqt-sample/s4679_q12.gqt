# issue: none
# notes: query-fuzz gen v1, world seed 4679, case 12; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  vec: enum(red, green, blue, x-1)? @unique @index
  level: [F64]
  rank: Vector(2)?
  code: Date? @index
  @index(level)
}
node Doc {
  level: String @key
  seen: F64?
  born: I64? @index
}
node Item {
  rank: DateTime? @index
  born: [Bool]
  note: F32?
}
node Org {
  flag: Date?
}
node Place {
  body: U64
  level: U32? @unique @index
}
edge Links: Tag -> Tag {
  weight: enum(a, b)
  role: I32?
  @unique(@src, @dst)
}
edge Likes: Tag -> Tag
edge Wrote: Tag -> Tag @card(0..2) {
  role: U64?
}
edge Knows: Tag -> Tag

