--- query
query q19($arg1: String, $arg2: String, $arg3: String) {
  match { let $pop = { match { $p1: Place, $o2: Org, $o2 wrote $p1, $o3: Org, $o3 wrote $p1, $p4: Place, $o2 wrote $p4 } where $p1.code = $arg1 and match_terms($p4.name, terms($arg2, mode: any)) return { $p1, $o2, $o3, $p4 } }, from bm25($pop, $p1.name, $arg3) as $score }
  return { $p1.code,  $o3.weight }
  order { $score desc }
  limit 1
}

