# issue: none
# notes: query-fuzz gen v1, world seed 4972, case 18; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  seen: String?
  slug: [Date]?
  size: U64? @unique
  rank: enum(red, green, blue, x-1)? @index
  text: String? @index
  emb: Vector(3)?
}
node Item {
  age: enum(red, green, blue, x-1)?
  rank: DateTime?
  content: String
}
node Tag {
  code: U32?
  content: I64 @key
  level: Blob?
  slug: U32 @unique @index
}
node Org {
  rank: Blob?
  weight: I64 @index
  score: Bool
  @range(weight, -10..1000)
}
node Place {
  flag: enum(a, b)? @index
  name: String @key
  content: [Date]
  code: enum(red, green, blue, x-1)?
}
edge Likes: Doc -> Doc {
  w: I32?
  @key(@src, @dst)
}
edge Near: Doc -> Doc {
  since: U32
}
edge Cites: Org -> Item {
  @unique(@src, @dst)
}
edge Wrote: Org -> Place @card(0..2) {
  w: enum(a, b)
}

