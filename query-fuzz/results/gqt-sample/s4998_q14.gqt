# issue: none
# notes: query-fuzz gen v1, world seed 4998, case 14; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  seen: enum(low, mid, high)
}
node Place {
  age: I32 @key
  content: [F64]
  size: U32?
}
node Doc {
  tags: U64? @index
  title: enum(red, green, blue, x-1)? @unique
  weight: enum(low, mid, high)
  vec: I32?
  age: enum(a, b)?
}
node Item {
  content: Vector(2)
  born: I64
}
edge Likes: Place -> Place {
  w: I32?
  since: String
}
edge Links: Place -> Place @card(0..1)

--- seed
{"type":"Person","id":"p0","data":{"seen":"high"}}
{"type":"Person","id":"p1","data":{"seen":"high"}}
{"type":"Person","id":"p2","data":{"seen":"mid"}}
{"type":"Doc","id":"d0","data":{"tags":0,"title":"blue","weight":"high","vec":0,"age":null}}
{"type":"Item","id":"i0","data":{"content":[0.5,0.5],"born":100}}
{"type":"Item","id":"i1","data":{"content":[1.72,-1.77],"born":-5}}
{"type":"Item","id":"i2","data":{"content":[1.72,0.01],"born":2}}
{"type":"Item","id":"i3","data":{"content":[0.5,0.5],"born":0}}
{"type":"Item","id":"i4","data":{"content":[0.96,0.94],"born":3}}
{"type":"Item","id":"i5","data":{"content":[1.0,0.0],"born":-5}}
{"type":"Item","id":"i6","data":{"content":[0.36,0.23],"born":-5}}
{"type":"Item","id":"i7","data":{"content":[1.2,-1.71],"born":0}}

--- query
query q15($arg1: [I64]) {
  match {
    $i1: Item
    $i1.born in $arg1 or $i1.born in [9007199254740993]
  }
  return { $i1.@id, max($i1.born) as a0, count($i1) as a1 }
  order { $i1.@id }
  limit 1
}

--- params
{"arg1": [-5, 2, 2147483647]}

--- expect ordered
{"i1.@id": "i1", "a0": -5, "a1": 1}

