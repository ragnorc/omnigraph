# issue: none
# notes: query-fuzz gen v1, world seed 500017, case 20; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  nums: U64? @index
  vec: String?
  flag: I64
  age: enum(a, b)
}
node Doc {
  slug: Blob?
  note: String
  weight: String @key
  body: I64?
  age: [I32]?
}
node Place {
  weight: String @unique
  text: String? @index
  emb: Vector(3)
}
edge Near: Doc -> Place @card(0..1)
edge Tagged: Doc -> Doc
edge Knows: Doc -> Doc
edge Links: Place -> Doc {
  @unique(@src, @dst)
}

