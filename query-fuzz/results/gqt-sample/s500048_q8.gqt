--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  vec: Vector(3)?
  slug: DateTime? @index
  nums: I64 @key
  code: String?
  text: String? @index
}

