--- mutate
query q9($arg1: String, $arg2: I64, $arg3: I64, $arg4: String) {
  insert Tag { slug: datetime("2020-01-01T00:00:00.123Z"), nums: 2.0, code: $arg1 }
  insert Tag { nums: $arg2 }
  insert Tag { slug: datetime("2020-01-01T00:00:00Z"), nums: $arg3, code: "abc", text: $arg4 }
}

--- params
{"arg1": "abc", "arg2": 3, "arg3": -5, "arg4": "dog"}

