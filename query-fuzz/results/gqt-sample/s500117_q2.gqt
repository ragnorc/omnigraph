# issue: none
# notes: query-fuzz gen v1, world seed 500117, case 2; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  content: DateTime?
  tags: Blob?
  seen: F32
}
node Person {
  count: F32 @index
  rank: enum(a, b)?
  body: [Date]?
}
node Item {
  score: enum(a, b)
  body: [String]
  seen: I32 @key
  weight: String @unique @index
  @index(body)
}
edge Tagged: Person -> Item @card(0..2)

