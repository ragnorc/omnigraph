--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  rank: U32 @index
  age: Vector(3)?
  text: String @index
}
node Org {
  score: Vector(3)?
  weight: F64
  slug: String @key
}
node Doc {
  vec: String @key
  name: F32 @index
  level: [I32]
  nums: Bool?
}
node Person {
  note: [I64]
  rank: enum(a, b)
  level: F64
}

