# issue: none
# notes: query-fuzz gen v1, world seed 500328, case 11; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  tags: Bool? @index
  body: F32
  note: Bool?
}
node Item {
  note: [I64]
  flag: enum(red, green, blue, x-1)?
  level: [I64]
}
node Doc {
  body: [F64]
  age: I64?
  count: I64
  text: String @index
  emb: Vector(3)?
}
edge Likes: Org -> Item {
  role: String?
  weight: Bool
}
edge Links: Org -> Item {
  weight: String?
  role: [String]?
  @key(@src, @dst)
}
edge Near: Org -> Org {
  w: F64?
}

