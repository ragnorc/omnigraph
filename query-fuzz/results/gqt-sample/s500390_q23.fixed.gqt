# issue: none
# notes: query-fuzz gen v1, world seed 500390, case 23; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  body: I64?
  rank: String @key
}
node Person {
  content: I32?
  text: String? @index
  emb: Vector(3)
  @range(content, -10..1000)
}
node Doc {
  size: enum(low, mid, high)?
  weight: I64? @index
  age: [F64]
  note: Blob?
  body: String?
}
edge Likes: Doc -> Doc {
  weight: enum(a, b)?
  w: I32?
}
edge Wrote: Doc -> Doc {
  role: [I64]?
}

