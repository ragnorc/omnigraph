# issue: none
# notes: query-fuzz gen v1, world seed 500426, case 17; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  count: [I64]?
  title: [I32]?
  note: U32? @index
  tags: Bool @index
  @index(title)
}
node Doc {
  level: String
  nums: U64? @index
  count: I32 @unique @index
  @key(level, count)
}
node Org {
  age: Bool?
  nums: enum(a, b)?
  count: String @index
}
node Tag {
  body: String @key
  count: [I32]?
  slug: enum(low, mid, high)?
  @index(count)
}
node Place {
  note: U64 @unique @index
}
edge Knows: Doc -> Doc
edge Links: Doc -> Tag
edge Cites: Doc -> Doc
edge Owns: Doc -> Doc {
  since: Bool?
}

