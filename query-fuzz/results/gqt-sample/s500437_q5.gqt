--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  level: enum(a, b)?
  note: F32 @index
  count: U32? @index
}
node Item {
  note: I64? @unique @index
  tags: I64
  content: I32
  rank: I32
  text: String? @index
  emb: Vector(3)
}
node Person {
  count: String @key
}
edge Cites: Org -> Org {
  @key(@src, @dst)
}
edge Links: Org -> Org

