# issue: none
# notes: query-fuzz gen v1, world seed 500507, case 16; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  weight: I64 @key
  size: [Date]?
  text: String? @index
  emb: Vector(3)
  @index(size)
}
node Item {
  age: String @key
}
node Place {
  age: enum(low, mid, high)
}
edge Tagged: Item -> Item
edge Near: Person -> Item

