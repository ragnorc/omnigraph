# issue: none
# notes: query-fuzz gen v1, world seed 500524, case 19; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  code: DateTime?
  note: U64
  content: F64
  score: F32? @index
}
node Org {
  level: F64? @index
  count: enum(red, green, blue, x-1)?
  title: Blob?
  note: Date @unique
  size: Bool @index
  text: String? @index
  emb: Vector(3)
}
node Place {
  flag: F64
}
node Doc {
  born: I64 @key
  level: Vector(3)?
  content: F32? @index
  @range(born, -10..1000)
}
node Item {
  code: I32 @index
  born: String @key
  level: I64? @index
}
edge Knows: Org -> Place {
  @unique(@src, @dst)
}
edge Likes: Doc -> Org

