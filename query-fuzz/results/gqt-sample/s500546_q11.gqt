# issue: none
# notes: query-fuzz gen v1, world seed 500546, case 11; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  code: I32
  nums: I32
  level: I32 @index
  body: U32 @index
  count: Bool?
}
node Place {
  note: U64? @index
  code: String @key
  level: enum(a, b) @index
}
node Doc {
  weight: U32?
  rank: U64?
  level: String?
  title: Blob?
  score: I64 @key
}
node Person {
  weight: [String]
  age: String? @index
  code: I32 @index
  @index(weight)
  @range(code, -10..1000)
}
node Tag {
  score: String @index
  seen: I32 @key
  flag: Bool @index
}
edge Likes: Org -> Place @card(0..1)

