# issue: none
# notes: query-fuzz gen v1, world seed 500554, case 8; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  code: enum(a, b)?
  score: String?
  nums: Vector(3)?
  tags: String? @unique @index
}
edge Tagged: Org -> Org {
  weight: I64
}
edge Wrote: Org -> Org {
  weight: String?
  since: [Date]
}
edge Likes: Org -> Org {
  weight: F32?
  role: I32?
}
edge Cites: Org -> Org

