# issue: none
# notes: query-fuzz gen v1, world seed 500577, case 7; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  note: [String]
  born: Bool @index
  body: F64?
  @index(note)
}
node Org {
  name: I64?
  code: String @key
  born: Date
  note: I32?
  title: Blob?
}
node Tag {
  flag: U32? @unique @index
  text: String? @index
  emb: Vector(3)
}

