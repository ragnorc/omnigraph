# issue: none
# notes: query-fuzz gen v1, world seed 500774, case 11; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  age: I32 @unique @index
  note: [I32]
  tags: I32 @key
  text: String @index
  emb: Vector(3)?
}
node Doc {
  age: [String]
  code: enum(red, green, blue, x-1)?
}
node Person {
  count: enum(low, mid, high)? @unique
  content: I32?
  nums: String @key
}
edge Likes: Person -> Person {
  role: I32?
}
edge Cites: Person -> Org
edge Tagged: Person -> Doc {
  @unique(@src, @dst)
}

