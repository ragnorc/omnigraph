# issue: none
# notes: query-fuzz gen v1, world seed 500826, case 14; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  slug: [Bool]?
  weight: I64 @key
  nums: [I64]
  body: Blob?
  @range(weight, -10..1000)
}
node Item {
  content: [I64]?
  weight: String @key
}
node Person {
  level: String @index
  code: String @key
  vec: String
  note: Blob?
}
node Place {
  content: [Date]
  count: Blob?
  size: DateTime
  text: String @index
  emb: Vector(3)
}
edge Owns: Item -> Item
edge Cites: Person -> Person
edge Links: Doc -> Item

