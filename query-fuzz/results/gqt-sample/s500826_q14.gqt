--- mutate
query q15($arg1: [I64], $arg2: String) {
  insert Item { content: $arg1, weight: "a" }
  insert Person { level: "and the", code: $arg2, vec: "runs" }
  insert Doc { weight: 9007199254740992, nums: [] }
}

