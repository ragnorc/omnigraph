--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  level: enum(low, mid, high)? @index
  tags: [Date]
}
node Doc {
  count: Vector(3)
  level: F64?
  slug: F32
  text: String @index
}
edge Cites: Person -> Person
edge Tagged: Person -> Person {
  role: enum(a, b)
  w: [I64]?
}
edge Likes: Person -> Person

