# issue: none
# notes: query-fuzz gen v1, world seed 500915, case 8; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  age: enum(low, mid, high)
  rank: F32 @index
  score: String
}
node Item {
  count: F32
  seen: String @index
  text: String? @index
  emb: Vector(3)?
}
node Org {
  body: Vector(3)?
  tags: Bool? @index
  slug: [Date]
}
edge Links: Item -> Place
edge Owns: Item -> Place {
  role: String
  since: Date?
}
edge Tagged: Item -> Place {
  @key(@src, @dst)
}

