--- query
query q9() {
  match { $p1: Place }
  return { $p1.rank as c0, $p1.score }
  order { $p1.score desc }
  limit 10
}

--- expect ordered
{"c0": -2.25, "p1.score": "of the and"}
{"c0": -2.25, "p1.score": "café"}
{"c0": 3.0, "p1.score": "café"}
{"c0": 1.5, "p1.score": "RUN"}

--- expect shape
c0: F32
p1.score: String
