--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  title: U32
  born: String @index
  note: I64
  level: F64?
  text: String? @index
  emb: Vector(3)
  @key(born, note)
}
node Person {
  count: I64? @index
  content: F64
  flag: I32 @key
}
edge Links: Org -> Person {
  w: String?
}
edge Near: Person -> Org {
  @key(@src, @dst)
}

