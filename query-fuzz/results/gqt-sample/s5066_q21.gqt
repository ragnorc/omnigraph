# issue: none
# notes: query-fuzz gen v1, world seed 5066, case 21; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  count: [F64]?
  rank: [String]?
  text: String? @index
  emb: Vector(3)?
  @index(count)
}
edge Near: Org -> Org
edge Likes: Org -> Org
edge Tagged: Org -> Org {
  weight: [I64]
  role: DateTime?
}
edge Knows: Org -> Org

