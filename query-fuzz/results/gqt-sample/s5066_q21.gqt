--- query
query q22($arg1: String, $arg2: Bool) {
  match {
    $o1: Org { text: "" }
    $o2 near $o1
    $o1.text in ["RUN the", "hello world", "café a"] or $arg1 in $o1.rank
  }
  return { $o1, count($o2) as a0, count($o2) as a1 }
}

--- params
{"arg1": "abc", "arg2": true}

