# notes: the generated world ran `omnigraph index build` after its load; this case does not
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
  vec: F32
  name: Date? @index
  count: Vector(2)
}
node Item {
  content: Bool
  weight: Date?
  name: Date @index
  age: U64
  nums: I64
}
node Org {
  seen: enum(low, mid, high) @index
  slug: String
  title: enum(low, mid, high) @index
}
edge Owns: Tag -> Item {
  role: String?
  since: [Date]
}
edge Likes: Item -> Org
edge Near: Tag -> Item
edge Wrote: Tag -> Item

