# issue: none
# notes: query-fuzz gen v1, world seed 5246, case 11; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  seen: I64?
}
node Tag {
  level: I32? @index
  content: DateTime?
  born: String @index
  slug: Blob?
  @range(level, -10..1000)
}
node Person {
  flag: Bool
  rank: [Bool]
  age: String @index
}
node Doc {
  title: Vector(2)?
  note: String? @index
}
node Org {
  tags: Blob?
  slug: U32 @index
  code: Bool
  name: U32?
  age: String? @index
}
edge Near: Person -> Tag {
  since: [I64]
}

