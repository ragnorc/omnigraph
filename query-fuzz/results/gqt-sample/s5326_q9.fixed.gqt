--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  body: [String]
  tags: F32? @index
  code: Vector(3)?
  @index(body)
}
node Place {
  nums: F32? @index
  code: Bool @index
  age: String? @unique @index
  note: F64?
}
edge Wrote: Place -> Place
edge Near: Place -> Item

