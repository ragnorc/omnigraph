# issue: none
# notes: query-fuzz gen v1, world seed 5379, case 11; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  level: Vector(3)?
  nums: F32?
  seen: U64? @unique @index
}
node Item {
  name: [I64]
  age: Vector(2)?
  text: String? @index
}
node Person {
  rank: F64 @index
  score: U32 @index
  nums: U64?
}
node Org {
  score: [I64]?
}
edge Owns: Place -> Place
edge Cites: Person -> Item
edge Wrote: Person -> Person {
  role: [F64]
  @unique(@src, @dst)
}

