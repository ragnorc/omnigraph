--- query
query q12($arg1: String) {
  match {
    $i1: Item { text: "run x" }  $i1.text <= "database" and $i1.text >= $arg1
  }
  return { $i1.age as c0  $i1.@id as c1 }
  order { bm25($i1.text, "xyz") desc, c0 }
  limit 2
}

--- params
{"arg1": "run x"}

--- expect ordered


--- expect shape
c0: Vector(2)
c1: String
