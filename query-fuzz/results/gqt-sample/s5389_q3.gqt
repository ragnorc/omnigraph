# issue: none
# notes: query-fuzz gen v1, world seed 5389, case 3; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  seen: enum(low, mid, high)? @index
  content: U32
  level: I32? @index
}
node Item {
  size: [Date]
  note: U32?
  level: F32? @index
  rank: U64? @index
  tags: I32
  text: String @index
  emb: Vector(3)
  @index(size)
}
node Org {
  seen: DateTime? @index
}

