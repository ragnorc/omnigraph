# issue: none
# notes: query-fuzz gen v1, world seed 5436, case 16; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  content: String? @index
  score: String @key
}
node Item {
  rank: String?
  code: I32?
  age: I64 @key
  body: F64 @index
  weight: Date?
}
node Person {
  level: F64
  weight: [String]?
  body: Date @index
  text: String @index
  emb: Vector(3)?
  @range(level, -10..1000)
}
edge Near: Person -> Item {
  weight: DateTime?
  since: enum(red, green, blue, x-1)?
}

--- seed
