--- query
query q17() {
  match {
    $i1: Item
  }
  return { $i1.weight  $i1.age as c1 }
  order { $i1.weight }
}

--- expect ordered
{"c1": 1}
{"i1.weight": "2024-02-29", "c1": -2147483648}

--- expect shape
i1.weight: Date?
c1: I64
