# issue: none
# notes: query-fuzz gen v1, world seed 5449, case 0; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  code: [Bool]?
  count: F64
  size: F32
  name: Vector(2)
  title: String @key
  @index(code)
}
node Person {
  tags: Bool?
  nums: F32? @index
  score: enum(red, green, blue, x-1)?
  level: [I64]?
}
node Place {
  note: F64? @index
  code: [F64]
  level: enum(red, green, blue, x-1)?
  vec: Vector(3)
  tags: enum(red, green, blue, x-1)?
}

--- seed
