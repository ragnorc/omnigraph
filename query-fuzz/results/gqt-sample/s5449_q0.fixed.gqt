{"type":"Item","data":{"code":[],"count":7.0,"size":-2.25,"name":[1.0,1.0],"title":"café"}}
{"type":"Place","id":"p0","data":{"note":0.1,"code":[-2.25,0.1,1.5],"level":"x-1","vec":[-1.23,1.64,1.46],"tags":"blue"}}
{"type":"Place","id":"p1","data":{"note":null,"code":[-2.25],"vec":[-0.98,-1.96,-0.41],"tags":"red"}}
{"type":"Place","id":"p2","data":{"note":10000000000.0,"code":[0.1],"level":"blue","vec":[1.0,0.0,0.0],"tags":"blue"}}
{"type":"Place","id":"p3","data":{"note":0.0,"code":[],"level":null,"vec":[-1.79,0.78,-1.28]}}

--- query
query q1($arg1: Vector(3)) {
  match { let $pop = { match { $p1: Place } where $p1.tags != "red" return { $p1 } }, from nearest($pop, $p1.vec, $arg1, k: 2) as $distance }
  return { $p1.@id as c0 }
  order { $distance }
  limit 2
}

--- params
{"arg1": [0.3, 0.2, -0.4]}

--- expect ordered
{"c0": "p2"}
{"c0": "p0"}

