# issue: none
# notes: query-fuzz gen v1, world seed 5507, case 8; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  level: [F64]
  title: [Date]?
  rank: I32 @key
  @index(level)
}
node Tag {
  born: enum(low, mid, high)? @index
}
node Place {
  count: Bool? @index
  name: [Bool]?
  flag: F32?
  nums: I64
  rank: Vector(3)
}
node Org {
  vec: [F64]
  body: Vector(2)?
  born: I64 @key
  text: String @index
  @index(vec)
}
node Item {
  slug: String? @index
  size: I64 @key
}
edge Tagged: Org -> Tag @card(0..2) {
  weight: Bool?
}
edge Links: Org -> Org {
  since: I64?
}
edge Owns: Place -> Place @card(0..2) {
  since: I32?
  @unique(@src, @dst)
}

