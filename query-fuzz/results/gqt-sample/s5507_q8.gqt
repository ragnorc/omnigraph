--- query
query q9($arg1: [I64], $arg2: Bool) {
  match {
    $t1: Tag { born: "mid" }
    $o2: Org
    $o2 tagged $t1
    $o2.born in $arg1 or $o2.vec contains 1.5
    match_text($o2.text, "a")
  }
  return { $o2.body, count(distinct $o2.born) as a0, max($o2.born) as a1 }
}

