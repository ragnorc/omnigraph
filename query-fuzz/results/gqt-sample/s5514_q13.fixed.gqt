# notes: the generated world ran `omnigraph index build` after its load; this case does not
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  rank: String @key
  flag: [I32]?
  nums: String @unique
  @index(flag)
}
node Tag {
  age: String?
  rank: U64 @unique
  content: DateTime @index
  text: String? @index
  emb: Vector(3)?
}
node Person {
  flag: enum(a, b)
  name: Vector(3)?
  vec: Blob?
}
edge Knows: Item -> Item @card(0..1)
edge Near: Item -> Person

