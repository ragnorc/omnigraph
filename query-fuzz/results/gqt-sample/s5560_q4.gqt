# issue: none
# notes: query-fuzz gen v1, world seed 5560, case 4; the edition-2 text, expectations blessed from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  level: F32?
  rank: String @key
}
node Item {
  seen: [F64]
  born: String? @index
  note: Vector(3)?
  flag: Blob?
  level: Vector(3)
}
node Tag {
  flag: [Bool]
  count: Bool?
  note: String @key
}
node Person {
  size: Vector(2)?
  name: [F64]
  code: [String]?
  @index(name)
}
node Place {
  seen: [I32]?
  age: Date
  name: String
  note: F64 @index
  body: String @key
}
edge Knows: Tag -> Tag {
  @unique(@src, @dst)
}
edge Owns: Doc -> Tag {
  since: DateTime?
  role: Bool?
  @unique(@src, @dst)
}
edge Likes: Doc -> Doc

