{"edge":"Knows","from":"dog house","to":"the"}

--- query
query q5($arg1: Bool) {
  match {
    $p1: Place { note: 0.0 }
    $p1.body starts_with "the" and $p1.seen contains 3
    count { $p1.body contains "the" } >= 0
  }
  return { $p1.name as c0, $p1.seen, max($p1.note) as a0, max($p1.note) as a1 }
  order { c0 desc }
}

