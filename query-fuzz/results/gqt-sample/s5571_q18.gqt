--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  body: [Date]
  @index(body)
}
node Place {
  level: I64
  size: I32 @index
  born: String? @index
  score: U32?
}
node Person {
  size: String?
}
edge Tagged: Item -> Person {
  role: enum(low, mid, high)
  weight: [String]?
}

