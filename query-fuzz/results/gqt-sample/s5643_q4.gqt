{"edge":"Likes","from":"i0","to":"dog house"}
{"edge":"Likes","from":"i4","to":"ab","data":{"role":"2020-01-01T00:00:00.123Z"}}
{"edge":"Likes","from":"i1","to":"Run","data":{"role":"2020-01-01T00:00:00Z"}}
{"edge":"Likes","from":"i2","to":"café","data":{"role":"2024-02-29T12:00:00Z"}}
{"edge":"Likes","from":"i0","to":"dog house","data":{"role":"2024-02-29T12:00:00Z"}}
{"edge":"Cites","from":"café","to":"dog house"}
{"edge":"Cites","from":"dog house","to":"Run"}

--- query
query q5() {
  match {
    $i1: Item
    $i1 $e3:links $o2
    $i1 likes $o4
    match_text($o2.flag, "rnu")
  }
  return { $o2.name as c0  $o2.flag }
  order { bm25($o4.flag, "cafe"), c0 }
  limit 3
}

