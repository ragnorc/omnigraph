# issue: none
# notes: query-fuzz gen v1, world seed 5679, case 20; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Place {
  code: I32?
  weight: enum(a, b) @index
  age: I32 @key
  @range(code, -10..1000)
}
node Person {
  level: enum(low, mid, high)? @index
  rank: U32?
  name: F32?
  count: I64 @key
  text: String? @index
  emb: Vector(3)
  @range(count, -10..1000)
}
edge Cites: Person -> Place {
  @key(@src, @dst)
}
edge Owns: Person -> Place
edge Near: Place -> Person

