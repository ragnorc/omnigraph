# notes: the generated world ran `omnigraph index build` after its load; this case does not
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
  code: Date?
  body: Date?
  content: [String]?
  flag: String @key
}
node Person {
  nums: Date?
  body: F32
  rank: String @key
  size: [String]
}
node Place {
  level: I32? @index
  count: I32?
  size: I32
  @range(level, -10..1000)
}
edge Likes: Person -> Item {
  weight: I32?
  role: enum(low, mid, high)
}
edge Wrote: Place -> Place

