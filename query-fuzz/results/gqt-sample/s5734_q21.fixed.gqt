--- mutate
query q22($arg1: Vector(2), $arg2: U32) {
  match { $x: Org } where $x.flag = "mid"  update $x set { slug: $arg1, flag: "high" }
  match { $p: Place } where $p.slug = date("2020-01-01") and $p.age > $arg2  update $p set { slug: date("1970-01-01"), weight: "b" }
}

--- params
{"arg1": [-0.0, 0.2], "arg2": 1}

--- expect affected: nodes=1 edges=0
