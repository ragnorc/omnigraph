# issue: none
# notes: query-fuzz gen v1, world seed 5734, case 21; the edition-2 text, expectations blessed from EDITION-2
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  slug: Vector(2)
  flag: enum(low, mid, high)? @index
  vec: F64 @index
}
node Place {
  weight: enum(a, b) @index
  content: DateTime? @index
  slug: Date?
  age: U32?
}
node Tag {
  level: Bool
  seen: Vector(3)?
  size: I32?
  content: [Date]
  text: String? @index
}
node Doc {
  seen: enum(a, b)? @index
}
node Item {
  vec: U64
  nums: I32? @index
  size: U64? @unique
}
edge Cites: Doc -> Item {
  role: [String]?
}
edge Knows: Doc -> Place {
  since: F64?
  @key(@src, @dst)
}
edge Likes: Place -> Place {
  since: [String]?
}
edge Owns: Doc -> Place

--- seed
