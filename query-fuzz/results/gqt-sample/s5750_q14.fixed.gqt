# issue: none
# notes: query-fuzz gen v1, world seed 5750, case 14; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not
# notes: the `omnigraph lint --fix` rewrite of the edition-2 text, expectations from EDITION-2

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  note: F32? @index
  vec: Vector(3)
  name: Vector(2)?
  weight: I32? @index
}
node Tag {
  vec: I32 @key
  age: [I64]?
  score: [Date]
  flag: F64 @index
  text: String @index
  emb: Vector(3)?
}
node Doc {
  code: String @key
  nums: I32
  content: String
  score: F32?
}
node Place {
  flag: [String]?
  seen: String @key
  weight: String? @unique @index
}
edge Cites: Doc -> Doc
edge Owns: Person -> Person @card(0..1)

--- seed
{"type":"Person","id":"p0","data":{"note":-2.25,"vec":[1.0,1.0,1.0],"weight":3}}
{"type":"Person","id":"p1","data":{"note":null,"vec":[-0.28,0.89,1.6],"name":[1.0,0.0],"weight":-1}}
{"type":"Tag","data":{"vec":2,"age":[42,7,100],"score":[],"flag":1.5,"text":"ran hello and the x","emb":[1.0,1.0,1.0]}}
{"type":"Place","data":{"seen":"ran","weight":"of the and"}}
{"type":"Place","data":{"flag":null,"seen":"a"}}
{"type":"Place","data":{"flag":["hello world","database","running"],"seen":"data base","weight":"RUN"}}
{"edge":"Owns","from":"p0","to":"p0"}

--- mutate
query q15() {
  insert Owns { @src: "p0", @dst: "p0" }
}

