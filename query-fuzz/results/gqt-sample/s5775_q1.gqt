--- query
query q2($arg1: String, $arg2: String) {
  match {
    $o1: Org
    "ran" in $o1.title
    $o1.title contains $arg1
    match_text($o1.vec, "dgo")
  }
  return distinct { $o1.name as c0  $o1.vec }
  order { bm25($o1.vec, $arg2) asc }
  limit 3
}

--- params
{"arg1": "café", "arg2": "cafe"}

