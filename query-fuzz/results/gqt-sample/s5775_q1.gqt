# issue: none
# notes: query-fuzz gen v1, world seed 5775, case 1; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  rank: enum(red, green, blue, x-1)
  weight: Blob?
  title: [String]?
  vec: String @key
  name: Date @index
  @index(title)
}
node Doc {
  level: Vector(3)
  name: I32? @index
  body: [Date]
}
node Item {
  note: F64
}
node Tag {
  title: String?
  count: String?
  born: I32 @key
  code: I32 @index
}
node Person {
  content: F64 @index
  nums: Date
  @range(content, -10..1000)
}
edge Wrote: Item -> Item
edge Likes: Person -> Person

