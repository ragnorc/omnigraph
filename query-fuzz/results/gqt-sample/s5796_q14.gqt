environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
  title: [String]?
  @index(title)
}
node Tag {
  born: I64?
  rank: Date
  score: I32 @key
  title: DateTime?
  age: U64? @index
}
node Item {
  seen: enum(red, green, blue, x-1)
  born: Vector(3)
  score: Vector(2)
}

