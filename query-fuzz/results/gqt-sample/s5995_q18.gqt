# issue: none
# notes: query-fuzz gen v1, world seed 5995, case 18; the edition-2 text, expectations blessed from EDITION-2
# notes: the generated world ran `omnigraph index build` after its load; this case does not

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
  code: U64? @index
  seen: String @key
  score: enum(low, mid, high)? @index
}
node Org {
  title: [Bool]
  text: String @index
  emb: Vector(3)?
  @index(title)
}
node Person {
  tags: String @key
}
node Place {
  age: I64 @unique
  code: F64
}
node Tag {
  seen: DateTime?
  body: F64? @index
  count: I64
}
edge Likes: Doc -> Doc @card(0..1) {
  role: [String]?
}
edge Owns: Org -> Org

