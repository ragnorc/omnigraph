--- query
query q19($arg1: DateTime) {
  match {
    $t1: Tag { seen: datetime("2020-01-01T00:00:00.123Z") }
    $p2: Person
    $t1.count in [7, 7] and $t1.seen >= $arg1
  }
  return { $t1.@id, $t1.count as c1, $p2 }
  order { c1 asc }
}

--- params
{"arg1": "2020-01-01T00:00:00.123Z"}

--- expect ordered
{"t1.@id": "t3", "c1": 7, "p2": {"@id": "hello world", "tags": "hello world"}}
{"t1.@id": "t3", "c1": 7, "p2": {"@id": "ran", "tags": "ran"}}

--- expect shape
t1.@id: String
c1: I64
p2: Person
