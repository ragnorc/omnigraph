--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Org {
  born: String
}
node Place {
  rank: [String]?
  flag: I64 @key
  body: [String]?
  born: U32?
  @range(flag, -10..1000)
}
node Person {
  level: Blob?
  age: Date? @index
  born: I32? @unique @index
  name: [F64]
  nums: enum(a, b)? @unique
}
edge Knows: Person -> Person @card(0..1) {
  role: [F64]?
  weight: I32?
}
edge Near: Person -> Person {
  role: Date?
  w: enum(a, b)?
}

