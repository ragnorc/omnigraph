--- schema
node Person {
  nums: Blob?
}
node Doc {
  weight: enum(a, b) @index
  tags: Date?
  text: String? @index
  emb: Vector(3)?
}
edge Wrote: Person -> Person @card(0..1)
edge Knows: Doc -> Doc {
  role: [Bool]
}

